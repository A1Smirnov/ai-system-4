# Only source trees are eligible. Runtime/configuration stay local.
/*
!/.gitignore
!/.gitattributes
!/.node-version
!/README.md
!/THIRD_PARTY_NOTICES.md
!/SOURCE-MANIFEST.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/.github/
!/docs/
!/types/
!/tests/
!/scripts/
!/config-templates/
!/extensions/
!/app/
/app/*
!/app/package.json
!/app/package-lock.json
!/app/vendor/
!/integrations/
/integrations/*
!/integrations/outlook/
/integrations/outlook/*
!/integrations/outlook/package.json
!/integrations/outlook/package-lock.json
!/personal-system/
/personal-system/*
!/personal-system/control/
/personal-system/control/*
!/personal-system/control/*.cjs
!/personal-system/control/*.js
!/personal-system/control/*.html
!/personal-system/control/*.css
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/auth.json
**/*.sqlite*
**/*.[sS][qQ][lL][iI][tT][eE]*
**/*.[dD][bB]
**/*.[dD][bB]3*
**/*-wal
**/*-shm
**/*-journal
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials.json
**/*.log
